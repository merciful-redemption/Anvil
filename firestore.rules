rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // 1. UserProfile Validation Blueprint
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.xp is int && data.xp >= 0 && data.xp <= 100000000 &&
             data.level is int && data.level >= 1 && data.level <= 1000 &&
             data.streak is int && data.streak >= 0 && data.streak <= 36500 &&
             data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 1 && data.dailyGoalMinutes <= 480 &&
             data.activeCourseId is string && data.activeCourseId.size() >= 1 && data.activeCourseId.size() <= 64 &&
             data.themeId is string && data.themeId.size() >= 1 && data.themeId.size() <= 64 &&
             data.calmMode is bool &&
             data.onboardingCompleted is bool &&
             (!('streakFreezes' in data) || (data.streakFreezes is int && data.streakFreezes >= 0 && data.streakFreezes <= 10)) &&
             (!('activeMinutesToday' in data) || (data.activeMinutesToday is int && data.activeMinutesToday >= 0 && data.activeMinutesToday <= 1440)) &&
             (!('lessonsCompletedTotal' in data) || (data.lessonsCompletedTotal is int && data.lessonsCompletedTotal >= 0 && data.lessonsCompletedTotal <= 100000)) &&
             (!('conceptsMasteredTotal' in data) || (data.conceptsMasteredTotal is int && data.conceptsMasteredTotal >= 0 && data.conceptsMasteredTotal <= 100000)) &&
             (!('restDaysCsv' in data) || (data.restDaysCsv is string && data.restDaysCsv.size() <= 64)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 2. ConceptState Validation Blueprint
    function isValidConceptState(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.conceptId is string && data.conceptId.size() >= 1 && data.conceptId.size() <= 128 &&
             data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 64 &&
             data.domain is string && data.domain.size() >= 1 && data.domain.size() <= 100 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.stability is number && data.stability >= 0 && data.stability <= 36500 &&
             data.difficulty is number && data.difficulty >= 1 && data.difficulty <= 10 &&
             data.reps is int && data.reps >= 0 && data.reps <= 100000 &&
             data.lapses is int && data.lapses >= 0 && data.lapses <= 100000 &&
             data.accuracyPermille is int && data.accuracyPermille >= 0 && data.accuracyPermille <= 1000 &&
             data.masteryState is string && data.masteryState.size() >= 1 && data.masteryState.size() <= 40 &&
             data.lastReviewEpochDay is int && data.lastReviewEpochDay >= 0 && data.lastReviewEpochDay <= 1000000 &&
             data.dueEpochDay is int && data.dueEpochDay >= 0 && data.dueEpochDay <= 1000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 3. CodeSnippet Validation Blueprint
    function isValidCodeSnippet(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.language is string && data.language.size() >= 1 && data.language.size() <= 40 &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 20000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.isFavorite is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 4. MistakeEntry Validation Blueprint
    function isValidMistakeEntry(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.exerciseId is string && data.exerciseId.size() >= 1 && data.exerciseId.size() <= 128 &&
             data.conceptId is string && data.conceptId.size() >= 1 && data.conceptId.size() <= 128 &&
             data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 64 &&
             data.promptSummary is string && data.promptSummary.size() >= 1 && data.promptSummary.size() <= 500 &&
             data.userAnswer is string && data.userAnswer.size() <= 5000 &&
             data.correctAnswer is string && data.correctAnswer.size() >= 1 && data.correctAnswer.size() <= 5000 &&
             data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 2000 &&
             data.retryCount is int && data.retryCount >= 0 && data.retryCount <= 1000 &&
             data.resolved is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 5. ProfileReport Validation Blueprint
    function isValidProfileReport(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 80 &&
             data.overallBand is string && data.overallBand in ['AD', 'PR', 'AP', 'DE', 'BE'] &&
             data.overallScorePermille is int && data.overallScorePermille >= 0 && data.overallScorePermille <= 1000 &&
             data.summaryNarrative is string && data.summaryNarrative.size() >= 1 && data.summaryNarrative.size() <= 4000 &&
             data.focusRecommendations is string && data.focusRecommendations.size() >= 1 && data.focusRecommendations.size() <= 4000 &&
             data.strengths is string && data.strengths.size() >= 1 && data.strengths.size() <= 4000 &&
             data.domainScoresSummary is string && data.domainScoresSummary.size() >= 1 && data.domainScoresSummary.size() <= 4000 &&
             data.activeMinutes is int && data.activeMinutes >= 0 && data.activeMinutes <= 100000 &&
             data.lessonsCompleted is int && data.lessonsCompleted >= 0 && data.lessonsCompleted <= 100000 &&
             data.conceptsMastered is int && data.conceptsMastered >= 0 && data.conceptsMastered <= 100000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'xp', 'level', 'streak',
                         'dailyGoalMinutes', 'activeCourseId', 'themeId',
                         'calmMode', 'onboardingCompleted', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'xp', 'level', 'streak', 'streakFreezes',
                         'dailyGoalMinutes', 'activeMinutesToday', 'lessonsCompletedTotal',
                         'conceptsMasteredTotal', 'activeCourseId', 'themeId',
                         'calmMode', 'onboardingCompleted', 'restDaysCsv', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'xp', 'level', 'streak', 'streakFreezes',
                         'dailyGoalMinutes', 'activeMinutesToday', 'lessonsCompletedTotal',
                         'conceptsMasteredTotal', 'activeCourseId', 'themeId',
                         'calmMode', 'onboardingCompleted', 'restDaysCsv', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /concept_states/{conceptId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(conceptId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(conceptId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'conceptId', 'courseId', 'domain', 'title',
                           'stability', 'difficulty', 'reps', 'lapses', 'accuracyPermille',
                           'masteryState', 'lastReviewEpochDay', 'dueEpochDay', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'conceptId', 'courseId', 'domain', 'title',
                           'stability', 'difficulty', 'reps', 'lapses', 'accuracyPermille',
                           'masteryState', 'lastReviewEpochDay', 'dueEpochDay', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidConceptState(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(conceptId) &&
                         request.auth.uid == userId &&
                         isValidConceptState(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().conceptId == existing().conceptId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'courseId', 'domain', 'title', 'stability', 'difficulty',
                           'reps', 'lapses', 'accuracyPermille', 'masteryState',
                           'lastReviewEpochDay', 'dueEpochDay', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(conceptId) && request.auth.uid == userId;
      }

      match /snippets/{snippetId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(snippetId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(snippetId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'language', 'code', 'category', 'isFavorite', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'language', 'code', 'category', 'isFavorite', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCodeSnippet(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(snippetId) &&
                         request.auth.uid == userId &&
                         isValidCodeSnippet(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'language', 'code', 'category', 'isFavorite', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(snippetId) && request.auth.uid == userId;
      }

      match /mistakes/{mistakeId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(mistakeId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(mistakeId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'exerciseId', 'conceptId', 'courseId',
                           'promptSummary', 'userAnswer', 'correctAnswer',
                           'explanation', 'retryCount', 'resolved', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'exerciseId', 'conceptId', 'courseId',
                           'promptSummary', 'userAnswer', 'correctAnswer',
                           'explanation', 'retryCount', 'resolved', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMistakeEntry(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(mistakeId) &&
                         request.auth.uid == userId &&
                         isValidMistakeEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().exerciseId == existing().exerciseId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'userAnswer', 'retryCount', 'resolved', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(mistakeId) && request.auth.uid == userId;
      }

      match /reports/{reportId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(reportId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(reportId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'periodLabel', 'overallBand', 'overallScorePermille',
                           'summaryNarrative', 'focusRecommendations', 'strengths',
                           'domainScoresSummary', 'activeMinutes', 'lessonsCompleted',
                           'conceptsMastered', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'periodLabel', 'overallBand', 'overallScorePermille',
                           'summaryNarrative', 'focusRecommendations', 'strengths',
                           'domainScoresSummary', 'activeMinutes', 'lessonsCompleted',
                           'conceptsMastered', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidProfileReport(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(reportId) &&
                         request.auth.uid == userId &&
                         isValidProfileReport(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'periodLabel', 'overallBand', 'overallScorePermille',
                           'summaryNarrative', 'focusRecommendations', 'strengths',
                           'domainScoresSummary', 'activeMinutes', 'lessonsCompleted',
                           'conceptsMastered', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(reportId) && request.auth.uid == userId;
      }
    }
  }
}
